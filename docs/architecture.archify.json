  "meta": {
    "title": "mesh-lab: Istio on a private EKS cluster",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ingress",
        "label": "Traffic in",
        "focus": [
          "operator",
          "nlb",
          "gateway",
          "hw1",
          "hw2",
          "httpbin"
        ],
        "note": "The NLB hands raw TCP to the Istio ingress gateway; a VirtualService splits /hello 90/10 between two versions and routes /httpbin/."
      },
      {
        "id": "mesh",
        "label": "Inside the mesh",
        "focus": [
          "istiod",
          "sleep",
          "httpbin",
          "hw1",
          "hw2"
        ],
        "note": "Every pod has a sidecar. istiod hands out certificates and config; STRICT mTLS and an AuthorizationPolicy decide who may call httpbin."
      },
      {
        "id": "access",
        "label": "Operator access",
        "focus": [
          "operator",
          "bastion",
          "apiserver",
          "istiod"
        ],
        "note": "The API endpoint is private. kubectl goes through the bastion; the API server must reach istiod's injection webhook on 15017."
      }
    ]
  },
