{
 "uid": "traffic-console",
 "title": "Traffic console",
 "tags": [
  "istio",
  "mesh-lab"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "Each button on the traffic console (`localhost:18080/console`) sends a burst; it appears here 10\u201320 seconds later. **Your bursts** counts only requests sent by the console. The other three count every caller, including loadgen: turn off *Background traffic* on the console page to see only your own requests."
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Your bursts, by response code",
   "description": "Requests sent by the console workload, as its own sidecar saw them (reporter=source).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (response_code) (rate(istio_requests_total{reporter=\"source\", source_workload=\"console\"}[30s]))",
     "legendFormat": "{{response_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "barAlignment": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "200"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#13807E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "403"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B3263E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "500"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7A3FA0"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "0"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7C8792"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "helloworld: requests by version",
   "description": "Everything helloworld received, split by the version label. The ratio follows the weights in mesh/gateway.yaml.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (destination_version) (rate(istio_requests_total{reporter=\"destination\", destination_app=\"helloworld\"}[30s]))",
     "legendFormat": "{{destination_version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "barAlignment": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "v1"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#13807E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "v2"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B7791F"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "httpbin: responses by code",
   "description": "Everything httpbin's sidecar answered. 403s were refused by the AuthorizationPolicy before reaching the app.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (response_code) (rate(istio_requests_total{reporter=\"destination\", destination_app=\"httpbin\"}[30s]))",
     "legendFormat": "{{response_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "barAlignment": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "200"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#13807E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "403"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B3263E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "500"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7A3FA0"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "httpbin: p95 latency",
   "description": "95% of httpbin's requests finished faster than this. The slow button pushes it to about 2 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_app=\"httpbin\"}[30s])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 2,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "barAlignment": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "templating": {
  "list": []
 }
}